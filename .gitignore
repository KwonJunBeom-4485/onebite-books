# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 환경 변수 중 .env.example 제외(허용)
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.git
.gitignore

# 빌드 산출물
.next

README.md
*.md

# 개발 전용 설정 파일
.eslintrc*
.prettierrc*
jest.config.*